# ===========================================
# Weather API Configuration
# ===========================================
# API Key de OpenWeatherMap (obtenerla en: https://openweathermap.org/api)
ACCESS_WEATHER_API_KEY=your_api_key_here

# URL base de la API de clima
ACCESS_URL_BASE_WEATHER_API=https://api.openweathermap.org

# Path del endpoint de clima actual
ACCESS_PATH_CITY_WEATHER=/data/2.5/weather

# ===========================================
# Redis Configuration
# ===========================================
# Host donde corre Redis (localhost para desarrollo local)
ACCESS_REDIS_HOST=localhost

# Puerto de Redis (por defecto: 6379)
ACCESS_REDIS_PORT=6379

# Número de base de datos Redis (0-15, usar 0 es común)
ACCESS_REDIS_DB=0

# ===========================================
# Cache Configuration
# ===========================================
# Tiempo de vida del caché en segundos
# 43200 segundos = 12 horas
ACCESS_CACHE_TTL_SECONDS=43200

# ===========================================
# Rate limiting configuration
ACCESS_RATE_LIMIT=count/period # Ejemplo: 10/minute, 100/hour, etc.
